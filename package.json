{
  "name": "markscrape",
  "version": "1.0.0",
  "description": "HTML & Asset to Markdown Engine",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "markscrape": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "build:ext": "vite build --config vite.extension.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "scraper",
    "markdown",
    "playwright",
    "readability",
    "turndown"
  ],
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "ora": "^9.4.1",
    "p-limit": "^7.3.3",
    "playwright": "^1.64.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
